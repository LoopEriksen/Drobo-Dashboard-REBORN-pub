<Window x:Class="DroboDashboardReborn.DiagnosticsChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copy diagnostics"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#0D1116" Foreground="#E6EBF0"
        FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7683"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <Style x:Key="ChoiceButton" TargetType="Button">
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Background" Value="#22262E"/>
            <Setter Property="Foreground" Value="#E6EBF0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#39424D"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <TextBlock Text="Copy diagnostics" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,2,0,16"
                   Text="Where should this go?"/>

        <Button x:Name="ClipboardBtn" Content="Copy to clipboard" Style="{StaticResource ChoiceButton}"
                Click="Clipboard_Click"/>
        <Button x:Name="FileBtn" Content="Save to a file…" Style="{StaticResource ChoiceButton}"
                Background="#2C7BC4" Foreground="White" BorderThickness="0"
                Click="File_Click" IsDefault="True"/>

        <Border Background="#2E2311" BorderBrush="#4A3A16" BorderThickness="1" CornerRadius="4"
                Padding="10,8" Margin="0,8,0,16">
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#E6EBF0"
                       Text="Either way, this includes your drive serial numbers -- check where it ends up before sharing it anywhere public."/>
        </Border>

        <CheckBox x:Name="Remember" Content="Remember my choice" Foreground="#E6EBF0" Margin="0,0,0,4"/>
        <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="You can change this later from the Tools tab."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelBtn" Content="Cancel" Padding="14,6"
                    Background="#22262E" Foreground="#E6EBF0" BorderThickness="1"
                    BorderBrush="#39424D" Cursor="Hand" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
